{
  // Cloudflare Worker that serves the game as static files, plus the /api/scores leaderboard
  "name": "rainbowed",
  "compatibility_date": "2026-06-01",
  "main": "src/worker.js",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // the leaderboard store; Wrangler creates the namespace on the first deploy
  "kv_namespaces": [{ "binding": "SCORES" }]
}
